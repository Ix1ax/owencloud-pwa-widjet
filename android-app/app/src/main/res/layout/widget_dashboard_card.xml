<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/seg_bg"
    android:minHeight="56dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView
            android:id="@+id/dashboard_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/dashboard_card_action"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bolt"
            android:tint="@color/blue"
            android:contentDescription="@string/dashboard_control" />
    </LinearLayout>
    <TextView
        android:id="@+id/dashboard_card_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="13sp" />
</LinearLayout>
