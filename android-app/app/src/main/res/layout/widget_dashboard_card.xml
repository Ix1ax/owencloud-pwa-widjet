<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dashboard_tile"
    android:minHeight="56dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView
            android:id="@+id/dashboard_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dashboard_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/dashboard_card_action"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bolt"
            android:tint="@color/dashboard_accent"
            android:contentDescription="@string/dashboard_control" />
    </LinearLayout>
    <TextView
        android:id="@+id/dashboard_card_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/dashboard_ink"
        android:textSize="17sp" android:fontFamily="sans-serif-medium" />
    <LinearLayout android:id="@+id/dashboard_card_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp"
        android:visibility="gone">
        <TextView android:id="@+id/dashboard_card_off" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:gravity="center" android:background="@drawable/dashboard_chip"
            android:textColor="@color/dashboard_accent" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/dashboard_card_on" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:gravity="center" android:background="@drawable/dashboard_chip"
            android:layout_marginStart="5dp" android:textColor="@color/dashboard_accent"
            android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
