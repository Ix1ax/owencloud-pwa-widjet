<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/dashboard_widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/dashboard_widget_name"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textStyle="bold" />
    <ImageView
        android:id="@+id/dashboard_widget_refresh"
        android:layout_width="42dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_refresh"
        android:tint="@color/text"
        android:contentDescription="@string/yandex_refresh" />
    <ImageView
        android:id="@+id/dashboard_widget_edit"
        android:layout_width="42dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_sliders"
        android:tint="@color/text"
        android:contentDescription="@string/dashboard_edit" />
</LinearLayout>
