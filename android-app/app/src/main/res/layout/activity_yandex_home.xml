<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusableInTouchMode="true"
        android:padding="16dp">

        <Button
            style="@style/YandexTextButton"
            android:id="@+id/yandex_back"
            android:text="@string/yandex_back" />

        <TextView
            style="@style/LargeTitle"
            android:accessibilityHeading="true"
            android:layout_marginBottom="16dp"
            android:text="@string/yandex_home" />

        <LinearLayout
            style="@style/Card"
            android:id="@+id/yandex_login"
            android:padding="16dp">

            <TextView
                style="@style/Secondary"
                android:text="@string/yandex_login_help" />

            <Button
                style="@style/Primary"
                android:id="@+id/yandex_sign_in"
                android:layout_marginTop="12dp"
                android:text="@string/yandex_sign_in" />

            <LinearLayout
                android:id="@+id/yandex_code_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/Secondary" android:text="@string/yandex_code_help" />

                <EditText
                    style="@style/Field"
                    android:id="@+id/yandex_code"
                    android:layout_marginTop="12dp"
                    android:hint="@string/yandex_code"
                    android:inputType="numberPassword"
                    android:importantForAutofill="no"
                    android:maxLength="7"
                    android:saveEnabled="false" />

                <Button
                    style="@style/Primary"
                    android:id="@+id/yandex_connect"
                    android:layout_marginTop="12dp"
                    android:text="@string/yandex_connect" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/yandex_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                style="@style/YandexTextButton"
                android:id="@+id/yandex_refresh"
                android:text="@string/yandex_refresh" />

            <Button
                style="@style/YandexTextButton"
                android:id="@+id/yandex_logout"
                android:text="@string/yandex_logout" />

            <TextView
                style="@style/Secondary"
                android:id="@+id/yandex_control_help"
                android:text="@string/yandex_control_help"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/Secondary"
            android:id="@+id/yandex_status"
            android:accessibilityLiveRegion="polite"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/yandex_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
