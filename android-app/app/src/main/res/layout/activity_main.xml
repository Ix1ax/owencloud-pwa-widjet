<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- ===== Вход ===== -->
        <LinearLayout
            android:id="@+id/login_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/circle_orange"
                android:contentDescription="@null"
                android:padding="18dp"
                android:src="@drawable/ic_flame" />

            <TextView
                style="@style/LargeTitle"
                android:layout_marginTop="18dp"
                android:text="@string/app_name"
                android:textSize="28sp" />

            <TextView
                style="@style/Secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp"
                android:text="Вход через аккаунт OwenCloud" />

            <EditText
                android:id="@+id/email"
                style="@style/Field"
                android:autofillHints="emailAddress"
                android:hint="Email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/password"
                style="@style/Field"
                android:layout_marginTop="10dp"
                android:autofillHints="password"
                android:hint="Пароль"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/login_btn"
                style="@style/Primary"
                android:layout_marginTop="16dp"
                android:text="Войти" />

            <TextView
                android:id="@+id/login_msg"
                style="@style/Secondary"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/red" />

            <TextView
                style="@style/Secondary"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Email и пароль хранятся только на этом телефоне и отправляются только в OwenCloud."
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== Главный экран ===== -->
        <LinearLayout
            android:id="@+id/ready_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Заголовок -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/device"
                    style="@style/LargeTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Котельная" />

                <TextView
                    android:id="@+id/menu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Меню"
                    android:gravity="center"
                    android:text="•••"
                    android:textColor="@color/blue"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/status_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:contentDescription="@null"
                    android:src="@drawable/circle_gray" />

                <TextView
                    android:id="@+id/status_line"
                    style="@style/Secondary"
                    android:layout_marginStart="6dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Температура -->
            <LinearLayout
                android:id="@+id/temp_card"
                style="@style/Card"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_orange"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_flame" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Secondary" android:text="Теплоноситель" />

                    <TextView
                        android:id="@+id/temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text="—"
                        android:textColor="@color/text"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/target"
                        style="@style/Secondary"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Плитки: горелка и аварии -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tile_burner"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/burner_icon"
                        style="@style/IconCircle"
                        android:background="@drawable/circle_gray"
                        android:src="@drawable/ic_bolt" />

                    <TextView
                        style="@style/Secondary"
                        android:layout_marginTop="12dp"
                        android:text="Горелка"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/burner_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="—"
                        android:textColor="@color/text"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_alarm"
                    style="@style/Card"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/alarm_icon"
                        style="@style/IconCircle"
                        android:background="@drawable/circle_gray"
                        android:src="@drawable/ic_shield" />

                    <TextView
                        android:id="@+id/alarm_label"
                        style="@style/Secondary"
                        android:layout_marginTop="12dp"
                        android:text="Аварии"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/alarm_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="—"
                        android:textColor="@color/text"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Причины аварии -->
            <LinearLayout
                android:id="@+id/errors"
                style="@style/Card"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView style="@style/SectionHeader" android:text="Управление" />

            <LinearLayout style="@style/Card">

                <!-- Режим -->
                <LinearLayout style="@style/Row">
                    <ImageView style="@style/IconCircle" android:background="@drawable/circle_purple" android:src="@drawable/ic_sliders" />
                    <TextView style="@style/RowLabel" android:text="Режим" />
                    <LinearLayout style="@style/Seg">
                        <TextView android:id="@+id/mode_auto" style="@style/SegItem" android:text="Авто" />
                        <TextView android:id="@+id/mode_manual" style="@style/SegItem" android:text="Ручной" />
                    </LinearLayout>
                </LinearLayout>
                <View style="@style/Separator" />

                <!-- Выбор уставки -->
                <LinearLayout style="@style/Row">
                    <ImageView style="@style/IconCircle" android:background="@drawable/circle_blue" android:src="@drawable/ic_target" />
                    <TextView style="@style/RowLabel" android:text="Уставка" />
                    <LinearLayout style="@style/Seg">
                        <TextView android:id="@+id/sel_1" style="@style/SegItem" android:text="1" />
                        <TextView android:id="@+id/sel_2" style="@style/SegItem" android:text="2" />
                    </LinearLayout>
                </LinearLayout>
                <View style="@style/Separator" />

                <!-- Уставка 1 -->
                <LinearLayout style="@style/Row">
                    <ImageView style="@style/IconCircle" android:background="@drawable/circle_orange" android:src="@drawable/ic_thermo" />
                    <TextView android:id="@+id/sp1_label" style="@style/RowLabel" android:text="Уставка 1" />
                    <TextView android:id="@+id/sp1_minus" style="@style/StepBtn" android:text="−" />
                    <TextView android:id="@+id/sp1_val" style="@style/StepVal" />
                    <TextView android:id="@+id/sp1_plus" style="@style/StepBtn" android:text="+" />
                </LinearLayout>
                <View style="@style/Separator" />

                <!-- Уставка 2 -->
                <LinearLayout style="@style/Row">
                    <ImageView style="@style/IconCircle" android:background="@drawable/circle_orange" android:src="@drawable/ic_thermo" />
                    <TextView android:id="@+id/sp2_label" style="@style/RowLabel" android:text="Уставка 2" />
                    <TextView android:id="@+id/sp2_minus" style="@style/StepBtn" android:text="−" />
                    <TextView android:id="@+id/sp2_val" style="@style/StepVal" />
                    <TextView android:id="@+id/sp2_plus" style="@style/StepBtn" android:text="+" />
                </LinearLayout>
                <View style="@style/Separator" />

                <!-- Удалённый старт -->
                <LinearLayout style="@style/Row">
                    <ImageView style="@style/IconCircle" android:background="@drawable/circle_green" android:src="@drawable/ic_play" />
                    <TextView style="@style/RowLabel" android:text="Удалённый старт" />
                    <Switch
                        android:id="@+id/start_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track" />
                </LinearLayout>
                <View style="@style/Separator" />

                <!-- Сброс -->
                <LinearLayout style="@style/Row">
                    <ImageView style="@style/IconCircle" android:background="@drawable/circle_red" android:src="@drawable/ic_refresh" />
                    <TextView style="@style/RowLabel" android:text="Сброс" />
                    <TextView
                        android:id="@+id/reset_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/pill_off"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="0"
                        android:textColor="@color/blue"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:minHeight="20dp"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
