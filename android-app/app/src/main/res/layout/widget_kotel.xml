<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Температура и лампы (нажатие — обновить) -->
    <LinearLayout
        android:id="@+id/w_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <!-- Лампы (нажатие — открыть приложение и посмотреть причину аварии) -->
        <LinearLayout
            android:id="@+id/w_lamps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_lamp_work"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Работа"
                android:src="@drawable/lamp_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Работа"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/w_lamp_alarm"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="12dp"
                android:contentDescription="Авария"
                android:src="@drawable/lamp_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Авария"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#A6FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Одна кнопка сброса: 0 ⇄ 1 -->
    <LinearLayout
        android:id="@+id/w_reset"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/reset_off"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_reset_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/w_reset_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:letterSpacing="0.05"
            android:text="СБРОС"
            android:textColor="#B3FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
