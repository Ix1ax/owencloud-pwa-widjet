<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 2×2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_orange"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_flame" />

        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/w_lamps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">
            <ImageView android:id="@+id/w_dot_work" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:src="@drawable/dot_off" />
            <TextView android:id="@+id/w_work_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
            <ImageView android:id="@+id/w_dot_alarm" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:src="@drawable/dot_off" />
            <TextView android:id="@+id/w_alarm_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/w_text"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_reset"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/w_rs_off"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Сброс 0"
            android:textColor="@color/blue"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
