<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 4×2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView
            android:id="@+id/w_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/circle_orange"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_flame" />
            <TextView
                android:id="@+id/w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/w_text"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/w_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="118dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_lamps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/w_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp">
                <ImageView android:id="@+id/w_dot_work" android:layout_width="8dp" android:layout_height="8dp" android:contentDescription="@null" android:src="@drawable/dot_off" />
                <TextView android:id="@+id/w_work_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/w_text" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="6dp" android:background="@drawable/w_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp">
                <ImageView android:id="@+id/w_dot_alarm" android:layout_width="8dp" android:layout_height="8dp" android:contentDescription="@null" android:src="@drawable/dot_off" />
                <TextView android:id="@+id/w_alarm_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/w_text" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView
                android:id="@+id/w_reset"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="@drawable/w_rs_off"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Сброс: 0"
                android:textColor="@color/blue"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
